{
  "name": "openEHR Bootcamp",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",

  // 4 cores / 16 GB is comfortable. 2 cores / 8 GB works but EHRbase starts slowly.
  "hostRequirements": { "cpus": 4 },

  "features": {
    // Lets the "Reset EHRbase" task restart the database from inside the editor.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": { "moby": false }
  },

  "forwardPorts": [5173, "ehrbase:8080"],
  "portsAttributes": {
    "5173": { "label": "My form", "onAutoForward": "openPreview" },
    "ehrbase:8080": { "label": "EHRbase API", "onAutoForward": "silent" }
  },

  // The form itself is started by the "Start my workspace" task (.vscode/tasks.json),
  // which runs automatically in a visible terminal each time the Codespace opens.
  "postCreateCommand": "npm install",

  "customizations": {
    "codespaces": { "openFiles": ["START-HERE.md"] },
    "vscode": {
      "extensions": ["esbenp.prettier-vscode", "humao.rest-client"],
      "settings": {
        "task.allowAutomaticTasks": "on",
        "files.autoSave": "afterDelay",
        "git.enableSmartCommit": true,
        "git.postCommitCommand": "push"
      }
    }
  }
}
